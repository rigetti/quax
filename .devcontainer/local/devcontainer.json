// For use with Visual Studio Code
{
  "name": "local",
  "dockerComposeFile": [
    "../../docker-compose.yml",
    "docker-compose.extend.yml"
  ],
  "remoteUser": "rigetti",
  "service": "lab",
  "workspaceFolder": "/home/rigetti/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "extensions": [
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-python.debugpy",
    "ms-toolsai.jupyter-renderers",
    "ms-toolsai.jupyter",
    "ms-vsliveshare.vsliveshare",
    "lakeFS.lakefs-dvc",
    "github.copilot-chat"
  ],
  "settings": {
    "python.defaultInterpreterPath": "/home/rigetti/.venv/${localWorkspaceFolderBasename}/bin/python",
    "python.pythonpath": "/home/rigetti/.venv/${localWorkspaceFolderBasename}/bin/python"
  }
}