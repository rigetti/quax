// For use with Coder
{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "coder",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../"
  },
  "runArgs": [
    "--gpus",
    "all"
  ],
  "remoteUser": "rigetti",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/rigetti/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "workspaceFolder": "/home/rigetti/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopContainer",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.jupyter",
        "ms-vsliveshare.vsliveshare",
        "lakeFS.lakefs-dvc",
        "github.copilot-chat",
        "openai.chatgpt",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/rigetti/.venv/${localWorkspaceFolderBasename}/bin/python"
      }
    }
  }
}
