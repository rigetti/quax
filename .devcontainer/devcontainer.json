// For use with Coder
{
  "name": "coder",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../"
  },
  "runArgs": ["--gpus", "all"],
  "remoteUser": "rigetti",
  "service": "lab",
  "workspaceFolder": "/home/rigetti/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "extensions": [
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-python.debugpy",
    "ms-toolsai.jupyter-renderers",
    "ms-toolsai.jupyter",
    "ms-vsliveshare.vsliveshare",
    "Iterative.dvc",
    "github.copilot-chat"  
  ],
  "settings": {
    "python.defaultInterpreterPath": "/home/rigetti/.venv/${localWorkspaceFolderBasename}/bin/python",
    "python.pythonpath": "/home/rigetti/.venv/${localWorkspaceFolderBasename}/bin/python"
  }
}
